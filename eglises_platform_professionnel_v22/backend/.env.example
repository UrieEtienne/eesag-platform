# Copiez ce fichier en ".env" et renseignez vos propres valeurs
SECRET_KEY=change-moi-en-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données : par défaut SQLite (dev). En production, utilisez PostgreSQL :
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=

# Origines autorisées pour le frontend React (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OTP SMS : Supabase Auth
SMS_PROVIDER=supabase
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_VOTRE_CLE

# Assistant IA (optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase Phone Auth
# Project URL from Supabase -> Settings -> API Keys
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SMS_PROVIDER=supabase
