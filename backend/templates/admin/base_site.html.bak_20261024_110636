{% extends "admin/base.html" %}
{% load static %}
{% load admin_scope %}

{% block title %}EESAG — Administration{% endblock %}

{% block extrastyle %}
    {{ block.super }}
    <link rel="stylesheet" href="{% static 'admin/css/ecg_admin.css' %}">
{% endblock %}

{% block branding %}
<div id="branding">

    <div>
        <h1>
            <a href="{% url 'admin:index' %}">
                EESAG
            </a>
        </h1>

        <small>Administration &amp; centre de contrôle</small>
    </div>

</div>
{% endblock %}


{% block userlinks %}

    {% if user.is_active and user.is_staff %}

        <span class="ecg-admin-user-preview">

            {% if user.photo %}
                <img
                    src="{{ user.photo.url }}"
                    alt="Photo de profil"
                >
            {% else %}
                <img
                    src="{% static 'admin/img/logo_eesag.jpg' %}"
                    alt="EESAG"
                >
            {% endif %}

        </span>

    {% endif %}

    {{ block.super }}

{% endblock %}


{% block nav-global %}

<div class="ecg-admin-global">

    <div class="ecg-admin-scope-pill">
        <span>PÉRIMÈTRE</span>
        <b>{% scope_label %}</b>
    </div>


    {% if user.role == 'COORDINATEUR' or user.is_superuser %}

        <a
            href="{% url 'admin:index' %}"
            class="is-active"
        >
            Tableau
        </a>

        <a href="{% url 'admin:churches_eglise_changelist' %}">
            Églises
        </a>

        <a href="{% url 'admin:accounts_utilisateur_changelist' %}">
            Comptes
        </a>

        <a href="{% url 'admin:bureaux_bureau_changelist' %}">
            Bureaux
        </a>

        <a href="{% url 'admin:finance_transaction_changelist' %}">
            Comptabilité
        </a>

        <a href="/systeme">
            Fonctionnalités
        </a>


    {% elif user.role == 'SUPERADMIN_INTL' or user.role == 'SUPERADMIN_NATIONAL' %}

        {% scope_is_national_general as general_national %}

        {% if general_national %}

            <a
                href="{% url 'admin:index' %}"
                class="is-active"
            >
                Tableau
            </a>

            <a href="{% url 'admin:churches_eglise_changelist' %}">
                Églises
            </a>

            <a href="{% url 'admin:accounts_utilisateur_changelist' %}">
                Comptes à contrôler
            </a>

            <a href="{% url 'admin:bureaux_bureau_changelist' %}">
                Bureaux
            </a>

        {% else %}

            <a
                href="{% url 'admin:index' %}"
                class="is-active"
            >
                Tableau
            </a>

            <a href="{% url 'admin:bureaux_bureau_changelist' %}">
                Mon bureau
            </a>

            <a href="{% url 'admin:bureaux_bureaumembre_changelist' %}">
                Composition
            </a>

        {% endif %}


    {% elif user.role == 'PASTEUR' or user.role == 'ADMIN_LOCAL' %}

        <a
            href="{% url 'admin:index' %}"
            class="is-active"
        >
            Tableau
        </a>

        <a href="{% url 'admin:accounts_utilisateur_changelist' %}">
            Membres &amp; comptes
        </a>

        <a href="{% url 'admin:bureaux_bureau_changelist' %}">
            Bureaux
        </a>

        <a href="{% url 'admin:finance_transaction_changelist' %}">
            Comptabilité
        </a>

    {% endif %}


    <a href="/">
        Ouvrir la plateforme
    </a>

</div>

{% endblock %}


{% block footer %}

<div id="footer">

    <span class="ecg-admin-footer-team">
        <a href="/informations">Équipe</a>
        · Développement EESAG
    </span>

</div>

{% endblock %}