/* ===== CORRECTION : RESTAURER LA SIDEBAR EESAG ===== */
#nav-sidebar,
.eesag-sidebar {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: fixed !important;
    top: 72px !important;
    left: 0 !important;
    bottom: 0 !important;
    width: 260px !important;
    height: calc(100vh - 72px) !important;
    overflow-y: auto !important;
    transform: none !important;
    z-index: 1000 !important;
    background: #172338 !important;
    color: #ffffff !important;
}

/* Décaler le contenu pour laisser la sidebar visible */
#content {
    margin-left: 260px !important;
}

/* Garder les liens de navigation lisibles */
#nav-sidebar a,
.eesag-sidebar a {
    color: #e8edf5 !important;
}

#nav-sidebar a:hover,
.eesag-sidebar a:hover {
    background: #263954 !important;
    color: #ffffff !important;
}

@media (min-width: 701px) {
    #nav-sidebar,
    .eesag-sidebar {
        display: block !important;
    }
}

/* ===== EESAG : RECENTRER LA NAVBAR ET LE FIL D'ARIANE ===== */

#header.eesag-header {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    height: 72px !important;
    padding: 0 22px !important;
    overflow: visible !important;
}

/* Logo et nom EESAG */
#header .eesag-header-brand {
    flex: 0 0 205px !important;
    min-width: 175px !important;
}

/* Navigation principale au centre */
#header .eesag-header-nav {
    flex: 1 1 auto !important;
    justify-content: center !important;
    align-items: center !important;
    min-width: 0 !important;
    overflow-x: auto !important;
}

/* Profil compact, sans pousser les autres éléments */
#header .eesag-header-user {
    flex: 0 1 255px !important;
    min-width: 0 !important;
    max-width: 255px !important;
    margin-left: 8px !important;
    justify-content: flex-end !important;
    gap: 7px !important;
}

#header .eesag-header-user-info {
    min-width: 0 !important;
    max-width: 175px !important;
}

#header .eesag-header-user-info strong,
#header .eesag-header-user-info small {
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}

/* Le contenu de la page commence sous la barre fixe */
#main {
    padding-top: 72px !important;
}

/* Fil d'Ariane : visible, aligné et non masqué */
#content .breadcrumbs {
    display: block !important;
    position: relative !important;
    z-index: 2 !important;
    clear: both !important;
    width: auto !important;
    margin: 0 0 18px 0 !important;
    padding: 12px 18px !important;
    overflow: visible !important;
    background: #f3f6f9 !important;
    color: #435466 !important;
    border-radius: 6px !important;
    box-sizing: border-box !important;
}

#content .breadcrumbs a {
    color: #0877b5 !important;
    text-decoration: none !important;
}

#content .breadcrumbs a:hover {
    text-decoration: underline !important;
}

/* Espace de contenu à droite de la sidebar */
@media (min-width: 701px) {
    #content {
        margin-left: 260px !important;
        padding: 22px 26px 40px !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }
}

/* Ajustement pour les écrans plus étroits */
@media (max-width: 1050px) {
    #header .eesag-header-brand {
        flex-basis: 150px !important;
        min-width: 125px !important;
    }

    #header .eesag-header-nav {
        justify-content: flex-start !important;
    }

    #header .eesag-header-user {
        flex-basis: auto !important;
        max-width: 45px !important;
    }
}

@media (max-width: 700px) {
    #header.eesag-header {
        height: 62px !important;
        padding: 0 10px !important;
    }

    #main {
        padding-top: 62px !important;
    }

    #content {
        margin-left: 0 !important;
        padding: 16px 12px 30px !important;
    }
}
